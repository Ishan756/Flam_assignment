# Copy this file to server/.env and fill in your values.
# The backend is OpenAI-compatible, so any provider works.
# Leave AI_API_KEY blank to use local Ollama, or to force "Demo mode" on the client.

# --- Example: OpenRouter (has free models) ---
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_API_KEY=sk-or-...
# AI_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Example: Groq ---
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_API_KEY=gsk_...
# AI_MODEL=llama-3.3-70b-versatile

# --- Example: Gemini (OpenAI-compatible endpoint) ---
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_API_KEY=AIza...
# AI_MODEL=gemini-1.5-flash

# --- Example: Local Ollama (no key) ---
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=
# AI_MODEL=qwen2.5:7b

AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# Port for the backend
PORT=4000
